# Riprap environment configuration. Copy to `.env`; every setting is
# optional. With nothing set, Riprap runs the no-LLM evidence briefing
# on CPU with no keys. Nothing reads this file by itself: pass it with
# `uv run --env-file .env uvicorn web.main:app --port 7860` or
# `docker run --env-file .env ...`.

# ---- LLM synthesis (optional) -----------------------------------------
# Any OpenAI-compatible endpoint turns on the LLM: it routes a question
# and picks which cited sentences answer it, and code checks its choice
# (docs/GROUNDING.md). Without one, code rules answer; with one, the rules
# still answer first and the model takes the rest (RIPRAP_RULES_FIRST=0
# puts the model first). Examples:
#   local Ollama:  RIPRAP_LLM_BASE_URL=http://localhost:11434/v1
#                  RIPRAP_LLM_MODEL=granite4:micro
#   vLLM:          RIPRAP_LLM_BASE_URL=http://your-vllm-host:8000/v1
#                  RIPRAP_LLM_MODEL=ibm-granite/granite-4.1-8b
# RIPRAP_LLM_BASE_URL=
# RIPRAP_LLM_MODEL=
# RIPRAP_LLM_API_KEY=

# Optional second endpoint, tried when the first does not answer.
# RIPRAP_LLM_FALLBACK_BASE_URL=
# RIPRAP_LLM_FALLBACK_MODEL=
# RIPRAP_LLM_FALLBACK_API_KEY=

# Force the no-LLM briefing even when an endpoint is configured.
# RIPRAP_RECONCILER_TIER=no_llm

# With an LLM configured, the rules still answer first and the model takes
# the questions they do not recognise. 0 puts the model first.
# RIPRAP_RULES_FIRST=1

# Send a bare address or district to the LLM to rewrite its evidence as
# claims (off: with no question there is nothing to answer).
# RIPRAP_LLM_BARE=0

# Seconds to wait for one LLM call.
# RIPRAP_LLM_TIMEOUT_S=300

# Ping the LLM at startup so the first question is not the cold one.
# RIPRAP_WARM=0

# ---- Experimental models (optional) -----------------------------------
# No setting turns them on: `uv sync --extra ml` installs the Battery
# surge forecast, and the satellite layers are saved files under data/eo
# (docs/MODELS.md). Another folder of saved outputs:
# RIPRAP_EO_DIR=data/eo

# ---- Data sources -----------------------------------------------------
# USGS Water Data API token; unauthenticated requests share a small
# hourly quota.
# API_USGS_PAT=

# Seconds a source may take before the briefing goes on without it.
# RIPRAP_SOURCE_BUDGET_S=45

# The HTTP cache of public-data responses: its file ("off" disables it)
# and how long a response is reused, in seconds.
# RIPRAP_HTTP_CACHE=~/.cache/riprap/http.sqlite
# RIPRAP_HTTP_CACHE_TTL_S=600

# Skip loading the map layers at startup (the first district query then
# pays for it).
# RIPRAP_SKIP_WARM=0

# Your own sources: manifest files or folders, colon-separated (docs/byod.md).
# RIPRAP_EXTRA_MANIFESTS=

# ---- Energy (optional) ------------------------------------------------
# Watts to assume for a local LLM endpoint when no meter is available
# (docs/EMISSIONS.md).
# RIPRAP_ENERGY_WATTS=

# ---- Deployment -------------------------------------------------------
# Default deployment when a query does not route by location.
# RIPRAP_DEPLOYMENT=deployments/nyc

# Record runs for the Burr tracking UI (development).
# RIPRAP_BURR_TRACKING=0
