# Riprap environment configuration. Copy to `.env`; every setting is
# optional. With nothing set, Riprap runs the no-LLM evidence briefing
# on CPU with no keys.

# ---- LLM synthesis (optional) -----------------------------------------
# Any OpenAI-compatible endpoint turns on the LLM: it routes a question
# and picks which cited sentences answer it, and code checks its choice
# (docs/GROUNDING.md). Without one, code rules answer. Examples:
#   local Ollama:  RIPRAP_LLM_BASE_URL=http://localhost:11434/v1
#                  RIPRAP_LLM_MODEL=granite4:micro
#   vLLM:          RIPRAP_LLM_BASE_URL=http://your-vllm-host:8000/v1
#                  RIPRAP_LLM_MODEL=ibm-granite/granite-4.1-8b
# RIPRAP_LLM_BASE_URL=
# RIPRAP_LLM_MODEL=
# RIPRAP_LLM_API_KEY=

# Optional second endpoint, tried when the first does not answer.
# RIPRAP_LLM_FALLBACK_BASE_URL=
# RIPRAP_LLM_FALLBACK_MODEL=
# RIPRAP_LLM_FALLBACK_API_KEY=

# Force the no-LLM briefing even when an endpoint is configured.
# RIPRAP_RECONCILER_TIER=no_llm

# ---- Data sources (optional keys) --------------------------------------
# USGS Water Data API token; unauthenticated requests share a small
# hourly quota.
# API_USGS_PAT=

# ---- Deployment -------------------------------------------------------
# Default deployment when a query does not route by location.
# RIPRAP_DEPLOYMENT=deployments/nyc
